{
  "name": "shopping-list",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "dev": "npm run db:up && concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "migrate": "tsx server/run-migrations.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down -v",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && mkdir -p dist-server/server && cp -R server/migrations dist-server/server/",
    "start": "node dist-server/server/index.js",
    "start:server": "node dist-server/server/index.js",
    "test:unit": "vitest run",
    "test:e2e": "./scripts/run-e2e.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "pg-mem": "^3.0.14",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
